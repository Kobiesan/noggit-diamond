{
  "name": "noggit-diamond",
  "version": "1.0.0",
  "description": "Noggit Diamond — a modern, browser-based World of Warcraft (WotLK 3.3.5a) map editor. Terrain sculpting, texture painting, water, objects, procedural generation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kobiesan/noggit-diamond"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
